# Kopiere diese Datei nach .env und trage die Werte ein.
# .env ist in .gitignore – der Schlüssel darf nie ins Repository.

# Pflicht. Ohne diesen Wert läuft der Wizard bis zum Kontaktformular,
# die KI-Analyse antwortet mit 503 und das Frontend zeigt den Rückfall.
OPENAI_API_KEY=

# Modell für die grosse Analyse (Schritt 5).
OPENAI_MODEL=gpt-5.6-terra

# Modell für die schnelle Ablauf-Erkennung (Schritt 2).
# Leer lassen, um dasselbe Modell wie oben zu verwenden.
OPENAI_MODEL_FAST=gpt-5.6-terra

# Für europäische Datenhaltung: https://eu.api.openai.com/v1
# Setzt die entsprechende Einstellung im OpenAI-Projekt voraus.
OPENAI_BASE_URL=https://api.openai.com/v1

# Empfänger der Anfragen aus dem Kontaktformular.
LEAD_EMPFAENGER=

# Optional. Ist der Schlüssel gesetzt, wird die Anfrage per E-Mail
# verschickt; sonst nur in data/leads.jsonl abgelegt.
RESEND_API_KEY=
RESEND_ABSENDER=Prozesscheck <prozesscheck@example.ch>

# Ratenbegrenzung je IP und Stunde.
RATE_LIMIT_ANALYSE_PRO_STUNDE=6
RATE_LIMIT_VERSTEHEN_PRO_STUNDE=40
RATE_LIMIT_LEAD_PRO_STUNDE=5
